{
  "name": "tickets-editor",
  "version": "0.1.0",
  "description": "Local-first multi-project ticket viewer and editor",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && npm run build:mcp",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && svelte-check --tsconfig tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "npm run build && electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "build:mcp": "esbuild src/mcp/server.ts --bundle --platform=node --format=esm --target=node24 --outfile=out/mcp/server.mjs --external:better-sqlite3",
    "mcp": "npm run build && electron . --mcp"
  },
  "dependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.2.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^13.2.0",
    "codemirror": "^6.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.0",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.3.8",
    "vitest": "^5.0.5",
    "esbuild": "^0.25.0",
    "@modelcontextprotocol/client": "^2.0.0"
  }
}
